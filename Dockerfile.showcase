FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY storefront/package*.json ./storefront/
RUN npm ci --prefix storefront
COPY . .
RUN npm run build:showcase

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY server/package*.json ./server/
RUN npm ci --omit=dev --prefix server
COPY server ./server
COPY --from=build /app/dist ./dist
COPY --from=build /app/storefront/dist ./storefront/dist
USER node
EXPOSE 3002
CMD ["node", "server/scripts/showcase.js"]
